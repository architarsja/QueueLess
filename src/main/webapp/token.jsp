<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.queueless.model.QueueEntry,com.queueless.dao.QueueDAO,com.queueless.dao.ServiceDAO" %>
<% QueueEntry entry=(QueueEntry)request.getAttribute("entry"); QueueDAO qd=new QueueDAO(); int ahead=qd.peopleAhead(entry); QueueEntry current=qd.current(entry.serviceId); int avg=5; var sm=new ServiceDAO().find(entry.serviceId); if(sm!=null) avg=sm.averageTime; int wait=ahead*avg; %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%=entry.token%> • QueueLess</title><link rel="stylesheet" href="css/style.css"></head><body class="app-shell"><header class="topbar"><a class="brand" href="index.html"><span class="brand-mark">Q</span><span>QueueLess</span></a><a class="top-link" href="queue-status.html?token=<%=entry.token%>">Track Queue <span>↗</span></a></header><main class="token-wrap"><section class="token-card"><div class="success-icon">✓</div><p class="eyebrow">REGISTRATION SUCCESSFUL</p><h1>Your turn is in the queue.</h1><p class="muted">Keep this token handy. The queue updates automatically.</p><div class="token-number"><span>YOUR TOKEN</span><strong><%=entry.token%></strong></div><div class="token-grid"><div><span>Currently Serving</span><strong id="serving"><%=current==null?"—":current.token%></strong></div><div><span>People Ahead</span><strong id="ahead"><%=ahead%></strong></div><div><span>Status</span><strong id="status"><%=entry.status%></strong></div><div><span>Estimated Wait</span><strong id="wait"><%=wait%> min</strong></div></div><div class="token-actions"><a class="btn btn-primary" href="queue-status.html?token=<%=entry.token%>">Track My Queue</a><a class="btn btn-secondary" href="register.html">Register Another</a></div><p class="live-note"><span class="live-dot"></span> Live queue tracking is enabled</p></section></main><script>const token='<%=entry.token%>';async function refresh(){try{const r=await fetch('api/queue/status?token='+encodeURIComponent(token));const d=await r.json();if(!d.success)return;document.getElementById('serving').textContent=d.currentlyServing||'—';document.getElementById('ahead').textContent=d.peopleAhead;document.getElementById('status').textContent=d.status==='WAITING'?'WAITING':d.status==='SERVING'?'YOUR TURN':d.status;document.getElementById('wait').textContent=d.estimatedWait+' min';}catch(e){}}refresh();setInterval(refresh,5000);</script></body></html>
